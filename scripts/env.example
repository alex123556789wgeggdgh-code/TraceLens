# TraceLens 团队模式（Docker Compose）环境变量样例（子任务 5.4 / t17）
#
# 用法：
#     cp scripts/env.example .env      # 在本仓库 agent-explainer/ 根目录下
#     编辑 .env 里至少 TRACELENS_ADMIN_PASSWORD 一项
#     docker compose up -d
#
# 说明：
#   · .env 只做 **compose 变量插值**；容器里实际拿到的是 compose 文件
#     environment: 那一段显式列出的变量（不会把你的 shell 环境整包塞进容器）。
#   · 本文件已被 .dockerignore / .gitignore 挡在镜像与版本库之外，
#     但**不要**把它当成密钥保险箱：生产环境请用 docker secret 或宿主的
#     密钥管理，这里只是"别把口令写进 compose 文件"的最低要求。

# ---- 必填：首个管理员口令 --------------------------------------------------
# team 模式零用户时用它创建 admin（用户名 admin），首次登录会被要求改密。
# 不设这一项 compose 会直接报错停下（宁可起不来，也不要"口令只打印在滚动日志里"）。
# 规格：≥10 位、不能是 password/tracelens 这类明显口令（auth.WEAK_PASSWORDS）。
TRACELENS_ADMIN_PASSWORD=replace-me-with-a-real-passphrase-2026

# ---- 可选：演示种子（首启为空时写入）--------------------------------------
# zh = 中文演示 12 条（默认，首启不空白）；en = 英文演示 12 条；none = 从 0 条开始
TRACELENS_DEMO=zh

# ---- 可选：端口 ------------------------------------------------------------
# 宿主端口；容器内始终是 8765
TRACELENS_PORT=8765

# ---- 可选：LLM 配置（不填＝模板模式，完全离线，功能不缺）-------------------
# 只有真的要用模型润色解释时才需要；这些值以环境变量注入，
# team/容器模式下**密钥永不落盘**（docs/03 §8，settings.py 的 ENV_* 优先）。
TRACELENS_LLM_MODE=template
TRACELENS_LLM_PROVIDER=
TRACELENS_LLM_BASE_URL=
TRACELENS_LLM_MODEL=
TRACELENS_LLM_API_KEY=
# 非回环地址要显式放行出网，否则服务端 403 LLM_OUTBOUND_BLOCKED
TRACELENS_LLM_ALLOW_OUTBOUND=0
TRACELENS_LLM_TIMEOUT_S=30

# ---- 可选：界面语言（zh / en）---------------------------------------------
TRACELENS_UI_LANGUAGE=zh
