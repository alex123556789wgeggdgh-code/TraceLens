{
  "name": "tracelens-desktop",
  "productName": "TraceLens 桌面端",
  "version": "0.5.0",
  "description": "TraceLens 桌面壳：拉起 Python sidecar（产品服务），等健康检查后加载同一套 Web UI",
  "private": false,
  "main": "main.js",
  "author": "TraceLens 团队",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "selfcheck": "electron . --selfcheck",
    "sidecar": "python -m agent_explainer --sidecar --browser",
    "build:sidecar": "python ../tools/build_sidecar.py",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "sign": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tools/sign_and_hash.ps1"
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {}
}
